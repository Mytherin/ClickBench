#!/bin/bash
# Start the persistent DuckDB "quack" server. Unlike the old embedded setup
# (which forked a fresh `duckdb hits.db` process for every query), the database
# now stays resident: warm tries connect over the quack protocol to this
# long-lived server, and the driver only restarts it — via ./stop + ./start with
# a cache flush in between — for the cold try of each query.
set -e

# Already running? ./start is called on every cold cycle and must be idempotent.
if [ -f quack.pid ] && kill -0 "$(cat quack.pid)" 2>/dev/null; then
    exit 0
fi

# Clean any stale WAL a prior crash/snapshot may have left: an unflushed .wal
# footer makes duckdb refuse to open the database ("IO Error: ... Bad message").
# Safe to drop — ./load CHECKPOINTs after ingest, so committed data lives in
# hits.db and the WAL holds nothing we need across a restart.
shopt -s nullglob
rm -f ./*.wal ./*.db.wal
rm -f quack.log quack.pid quack.holder.pid

# quack_serve() starts the server on a background thread and returns, so the
# duckdb process must be kept alive for the server to keep serving. We run the
# serve command from serve.sql via -init, then wire the CLI's stdin to a fifo
# held open by a background `sleep`. The CLI never sees EOF, so it blocks in its
# read loop and the quack server stays up until ./stop kills both processes.
#
# Always open the on-disk hits.db (creating an empty one on a fresh machine):
# ./load ingests into this database over quack and the data must survive the
# per-query cold-cycle restarts, so the server has to be file-backed.
rm -f quack.in
mkfifo quack.in
duckdb hits.db -init serve.sql < quack.in > quack.log 2>&1 &
echo $! > quack.pid
sleep 2147483647 > quack.in &
echo $! > quack.holder.pid
